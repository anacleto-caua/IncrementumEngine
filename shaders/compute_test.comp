#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer TestBuffer {
    uint Values[];
} OutBuffer;

layout(push_constant) uniform PushConstants {
    uint Multiplier;
    uint Offset;
} PC;

// Writes an affine function of the invocation index rather than just the index itself, so a
// buffer that happened to already be zeroed can't pass verification by accident, and flipping the
// push constants exercises that path too (not just descriptor binding).
void main() {
    uint index = gl_GlobalInvocationID.x;
    OutBuffer.Values[index] = index * PC.Multiplier + PC.Offset;
}
